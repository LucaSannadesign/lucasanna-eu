---
const currentPath = Astro.url.pathname;
const links = [
  { href: '/progetti/', label: 'Progetti' },
  { href: '/chi-sono/', label: 'Profilo' },
  { href: '/metodo/', label: 'Metodo' },
  { href: '/contatti/', label: 'Contatti' }
];
const isActive = (href: string) => currentPath.startsWith(href);
---
<header class="portfolio-header">
  <div class="container-unified portfolio-header-inner">
    <a class="portfolio-logo" href="/" aria-label="Luca Sanna, torna alla homepage">
      <img src="/images/logo-lucasanna.svg" width="140" height="28" alt="Luca Sanna" decoding="async" />
    </a>
    <nav class="portfolio-desktop-nav" aria-label="Navigazione principale">
      {links.map(link => (
        <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>
    <div class="portfolio-actions">
      <a class="portfolio-github" href="https://github.com/LucaSannadesign" rel="noopener noreferrer" target="_blank" aria-label="Profilo GitHub, si apre in una nuova scheda">GitHub ↗</a>
      <details class="portfolio-mobile">
        <summary aria-label="Apri il menu di navigazione">Menu <span aria-hidden="true">☰</span></summary>
        <nav aria-label="Navigazione mobile">
          {links.map(link => (
            <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>
          ))}
          <a href="https://github.com/LucaSannadesign" rel="noopener noreferrer" target="_blank">GitHub ↗</a>
        </nav>
      </details>
    </div>
  </div>
</header>
<style>
.portfolio-header{position:sticky;top:0;z-index:100;background:rgb(var(--paper)/.95);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid rgb(var(--border)/.22)}
.portfolio-header-inner{min-height:76px;display:flex;align-items:center;justify-content:space-between;gap:2rem}
.portfolio-logo{display:flex;align-items:center;flex:none}
.portfolio-logo img{width:140px;height:auto;max-height:45px}
.portfolio-desktop-nav{display:flex;align-items:center;gap:clamp(1.1rem,2.7vw,2.7rem);margin-left:auto}
.portfolio-desktop-nav a,.portfolio-github{font-size:.87rem;font-weight:600;color:rgb(var(--ink));text-decoration:none;white-space:nowrap;position:relative;padding:.55rem 0}
.portfolio-desktop-nav a:after{content:'';position:absolute;bottom:0;left:0;width:100%;height:2px;background:rgb(var(--accent));transform:scaleX(0);transition:transform .2s;transform-origin:left}
.portfolio-desktop-nav a:hover:after,.portfolio-desktop-nav a[aria-current='page']:after{transform:scaleX(1)}
.portfolio-actions{display:flex;align-items:center}
.portfolio-github{margin-left:1.5rem;border:1px solid rgb(var(--border)/.35);border-radius:99px;padding:.7rem 1.15rem}
.portfolio-github:hover{border-color:rgb(var(--accent));color:rgb(var(--accent))}
.portfolio-mobile{display:none;position:relative}
.portfolio-mobile summary{display:flex;gap:.65rem;align-items:center;min-height:44px;padding:.5rem .9rem;border:1px solid rgb(var(--border)/.35);border-radius:.5rem;list-style:none;cursor:pointer;color:rgb(var(--ink));font-size:.88rem;font-weight:700}
.portfolio-mobile summary::-webkit-details-marker{display:none}
.portfolio-mobile nav{position:absolute;right:0;top:calc(100% + 1rem);display:flex;flex-direction:column;gap:.25rem;width:min(85vw,310px);border:1px solid rgb(var(--border)/.3);border-radius:.8rem;background:rgb(var(--paper));padding:.65rem;box-shadow:0 20px 40px rgb(var(--ink)/.12)}
.portfolio-mobile nav a{display:block;padding:.8rem .9rem;font-size:.96rem;font-weight:600;color:rgb(var(--ink));text-decoration:none;border-radius:.5rem}
.portfolio-mobile nav a:hover,.portfolio-mobile nav a[aria-current='page']{background:rgb(var(--accent)/.09)}
.portfolio-header a:focus-visible,.portfolio-mobile summary:focus-visible{outline:2px solid rgb(var(--accent));outline-offset:3px}
@media(max-width:780px){.portfolio-desktop-nav,.portfolio-github{display:none}.portfolio-mobile{display:block}.portfolio-header-inner{min-height:66px}}
@media(prefers-reduced-motion:reduce){.portfolio-desktop-nav a:after{transition:none}}
</style>
