<footer class="dev-footer">
  <div class="container-unified dev-footer-grid">
    <div class="dev-footer-intro">
      <a href="/" class="dev-footer-name">Luca Sanna<span aria-hidden="true">.</span></a>
      <p>Front-end Developer &amp; UI Engineer. Interfacce, applicazioni web e prodotti digitali con attenzione a design, accessibilità e qualità del codice.</p>
      <a href="mailto:info@lucasanna.eu">info@lucasanna.eu ↗</a>
    </div>
    <nav aria-label="Link del portfolio">
      <h2>Esplora</h2>
      <a href="/progetti/">Progetti software</a>
      <a href="/case-studies/">Archivio web e visual</a>
      <a href="/chi-sono/">Profilo</a>
      <a href="/metodo/">Metodo</a>
      <a href="/contatti/">Contatti</a>
    </nav>
    <nav aria-label="Profili professionali">
      <h2>Collegamenti</h2>
      <a href="https://github.com/LucaSannadesign" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      <a href="https://www.linkedin.com/in/lucasanna-art/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
      <a href="https://www.lswebagency.com/" target="_blank" rel="noopener noreferrer">LS Web Agency ↗</a>
    </nav>
  </div>
  <div class="container-unified dev-footer-bottom">
    <p>© {new Date().getFullYear()} Luca Sanna. Portfolio personale.</p>
    <p>Le attività commerciali di web design e consulenza sono presentate separatamente su <a href="https://www.lswebagency.com/" target="_blank" rel="noopener noreferrer">LS Web Agency</a>.</p>
  </div>
</footer>
<style>
.dev-footer{background:rgb(var(--paper));border-top:1px solid rgb(var(--border)/.25);padding:4rem 0 2rem}
.dev-footer-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr;gap:clamp(2rem,5vw,6rem)}
.dev-footer-name{font-size:1.6rem;letter-spacing:-.04em;font-weight:700;text-decoration:none;color:rgb(var(--ink))}
.dev-footer-name span{color:rgb(var(--accent))}
.dev-footer-intro p{max-width:39ch;font-size:.94rem;color:rgb(var(--muted));line-height:1.7;margin:1rem 0 1.4rem}
.dev-footer nav{display:flex;flex-direction:column;align-items:start;gap:.7rem}
.dev-footer nav h2{font-size:.75rem;letter-spacing:.13em;font-weight:700;text-transform:uppercase;color:rgb(var(--muted));margin-bottom:.4rem}
.dev-footer a:not(.dev-footer-name){color:rgb(var(--ink));font-size:.87rem;text-decoration:none;border-bottom:1px solid transparent}
.dev-footer a:hover:not(.dev-footer-name){border-color:rgb(var(--accent));color:rgb(var(--accent))}
.dev-footer a:focus-visible{outline:2px solid rgb(var(--accent));outline-offset:4px}
.dev-footer-bottom{border-top:1px solid rgb(var(--border)/.25);padding-top:1.5rem;margin-top:3rem;display:flex;justify-content:space-between;gap:2rem}
.dev-footer-bottom p{font-size:.75rem;line-height:1.6;color:rgb(var(--muted));max-width:52ch}
@media(max-width:680px){.dev-footer-grid{grid-template-columns:1fr 1fr;gap:2.6rem}.dev-footer-intro{grid-column:1/-1}.dev-footer-bottom{flex-direction:column;gap:.4rem}}
</style>
